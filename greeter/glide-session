#!/bin/sh
# Обёртка сеанса для экрана входа Glide: greetd запускает «glide-session niri-session».
# Пока niri сеанса стартует, на VT видна текстовая консоль — стираем её и прячем курсор (будет просто чёрный экран).
# Отдельным файлом, а не «sh -c '…'»: greetd склеивает аргументы через пробел и разбирает строку заново.
printf '\033[2J\033[3J\033[H\033[?25l' 2>/dev/null
exec "$@"
